<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RequiredTargetFrameworks>net10.0</RequiredTargetFrameworks>
    <TargetFrameworks>$(RequiredTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <ProjectReference Include="../../Azure.ResourceManager.Compute/src/Azure.ResourceManager.Compute.csproj">
      <Aliases>Original</Aliases>
    </ProjectReference>
    <ProjectReference Include="../src/Azure.ResourceManager.Compute.Virtual.csproj">
      <Aliases>Virtualized</Aliases>
    </ProjectReference>
    <None Update="VirtualMachine.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
